		color: #111a26;
	}

	.btn-above {
		margin-top: 0;
		margin-bottom: 10px;
	}

	.p-gap {
		margin-top: 10px;
		font-size: 14px;
		color: #6a7686;
	}

	.hist {
		align-items: center;
		background-color: #ffffff;
		border-radius: 14px;
		padding: 10px 12px;
		margin-bottom: 10px;
	}

	.hist-go {
		font-size: 13px;
		color: #1b5fd9;
	}

	.pill {
		padding: 5px 10px;
		border-radius: 14px;
		background-color: #e3f6ee;
	}

	.pill-off {
		background-color: #ffe9e9;
	}

	.pill-t {
		font-size: 12px;
		color: #12855a;
	}

	.pill-t-off {
		color: #ef2b2d;
	}

	/* scrolling body and bottom bar */
	.body {
		flex: 1;
		padding: 4px 16px 16px 16px;
	}

	.cta {
		padding: 10px 16px 18px 16px;
		background-color: #f4f6fa;
	}

	.btn-main {
		height: 54px;
		border-radius: 16px;
		background-color: #1b5fd9;
		align-items: center;
		justify-content: center;
		margin-top: 8px;
	}

	.btn-main-t {
		font-size: 17px;
		font-weight: bold;
		color: #ffffff;
	}

	.btn-2 {
		height: 46px;
		border-radius: 14px;
		background-color: #ffffff;
		align-items: center;
		justify-content: center;
		margin-top: 8px;
	}

	.btn-2-t {
		font-size: 15px;
		font-weight: bold;
		color: #111a26;
	}

	.btn-dark {
		height: 42px;
		border-radius: 12px;
		background-color: #111a26;
		align-items: center;
		justify-content: center;
		margin-top: 12px;
	}

	.btn-dark-t {
		font-size: 14px;
		font-weight: bold;
		color: #ffffff;
	}

	/* conversation */
	.card {
		background-color: #ffffff;
		border-radius: 18px;
		border-top-left-radius: 4px;
		padding: 12px 14px 14px 14px;
		margin-bottom: 12px;
	}

	.name {
		font-size: 12px;
		font-weight: bold;
		color: #1b5fd9;
		margin-bottom: 6px;
	}

	.p {
		font-size: 15px;
		color: #111a26;
		line-height: 23px;
	}

	.h3 {
		font-size: 12px;
		font-weight: bold;
		color: #6a7686;
		margin-top: 12px;
		margin-bottom: 6px;
	}

	.hint {
		font-size: 13px;
		color: #6a7686;
		margin-top: 4px;
	}

	.field {
		height: 40px;
		border-radius: 10px;
		background-color: #f4f6fa;
		padding: 0 10px;
		font-size: 14px;
		color: #111a26;
		margin-top: 6px;
	}

	.me {
		align-self: flex-end;
		max-width: 300px;
		background-color: #1b5fd9;
		border-radius: 18px;
		border-bottom-right-radius: 4px;
		padding: 10px 13px;
		margin-bottom: 12px;
	}

	.me-t {
		font-size: 15px;
		color: #ffffff;
		line-height: 22px;
	}

	.sys {
		align-self: center;
		background-color: #ffe9e9;
		border-radius: 10px;
		padding: 8px 12px;
		margin-bottom: 12px;
	}

	.sys-t {
		font-size: 13px;
		color: #b3191b;
		line-height: 20px;
	}

	.eg {
		align-self: flex-start;
		background-color: #e8f0ff;
		border-radius: 16px;
		padding: 7px 13px;
		margin-bottom: 12px;
	}

	.eg-t {
		font-size: 13px;
		font-weight: bold;
		color: #1b5fd9;
	}

	.wait {
		font-size: 13px;
		color: #6a7686;
		margin-bottom: 12px;
	}

	/* parcel ticket */
	.ticket {
		align-items: center;
		background-color: #f4f6fa;
		border-radius: 12px;
		padding: 8px 10px;
		margin-top: 8px;
	}

	.label {
		width: 78px;
		height: 44px;
		background-color: #ffffff;
		border-width: 1.5px;
		border-style: solid;
		border-color: #111111;
		border-radius: 4px;
		align-items: center;
		justify-content: center;
	}

	.label-t {
		font-size: 24px;
		font-weight: bold;
		color: #111111;
		line-height: 28px;
	}

	.where {
		flex: 1;
		margin-left: 12px;
		margin-right: 8px;
	}

	.where-b {
		font-size: 15px;
		font-weight: bold;
		color: #111a26;
	}

	.where-s {
		font-size: 12px;
		color: #6a7686;
		margin-top: 2px;
	}

	.state {
		padding: 3px 8px;
		border-radius: 10px;
		background-color: #e8f0ff;
	}

	.state-ok {
		background-color: #e3f6ee;
	}

	.state-t {
		font-size: 11px;
		font-weight: bold;
		color: #1b5fd9;
	}

	.state-t-ok {
		color: #12855a;
	}

	.plan {
		align-items: flex-start;
		margin-top: 6px;
	}

	.num {
		width: 20px;
		height: 20px;
		border-radius: 10px;
		background-color: #e8f0ff;
		align-items: center;
		justify-content: center;
		margin-right: 8px;
		margin-top: 1px;
	}

	.num-t {
		font-size: 11px;
		font-weight: bold;
		color: #1b5fd9;
	}

	.plan-t {
		flex: 1;
		font-size: 14px;
		color: #111a26;
		line-height: 21px;
	}

	/* input row */
	.say {
		align-items: flex-end;
		background-color: #ffffff;
		border-radius: 22px;
		padding: 5px;
	}

	.say-input {
		flex: 1;
		min-height: 40px;
		max-height: 110px;
		font-size: 16px;
		line-height: 22px;
		color: #111a26;
		padding: 9px 6px;
	}

	.icon-btn {
		width: 40px;
		height: 40px;
		border-radius: 20px;
		align-items: center;
		justify-content: center;
	}

	.icon {
		width: 26px;
		height: 26px;
	}

	.hold {
		flex: 1;
		height: 40px;
		border-radius: 20px;
		background-color: #f4f6fa;
		align-items: center;
		justify-content: center;
		margin: 0 4px;
	}

	.hold-on {
		background-color: #d9dee6;
	}

